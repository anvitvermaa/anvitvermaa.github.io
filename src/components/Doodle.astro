---
// Loose, hand-drawn ink doodles for the sketch background.
interface Props { kind?: string; accent?: boolean; style?: string; draw?: boolean; }
const { kind = 'star', accent = false, style = '', draw = true } = Astro.props;
const dc = draw ? 'draw' : '';
---
<div class:list={['doodle', accent && 'doodle--accent']} style={style} aria-hidden="true">
  <svg viewBox="0 0 100 100">
    {kind === 'star' && (
      <path class={dc} d="M50 6 C55 38 62 45 94 50 C62 55 55 62 50 94 C45 62 38 55 6 50 C38 45 45 38 50 6 Z" />
    )}
    {kind === 'scribble' && (
      <path class={dc} d="M6 62 C22 34 30 82 42 54 C53 30 60 78 72 50 C82 28 90 58 96 46" />
    )}
    {kind === 'spiral' && (
      <path class={dc} d="M56 50 C56 43 45 43 45 52 C45 65 64 65 65 49 C66 28 39 28 36 53 C32 85 74 86 78 46" />
    )}
    {kind === 'wave' && (
      <path class={dc} d="M4 52 C16 38 28 66 40 52 C52 38 64 66 76 52 C85 42 92 52 97 48" />
    )}
    {kind === 'circle' && (
      <path class={dc} d="M52 10 C80 9 92 34 88 54 C84 76 62 92 42 87 C21 82 10 60 16 40 C21 24 36 12 56 13" />
    )}
    {kind === 'arrow' && (
      <>
        <path class={dc} d="M8 34 C38 12 72 22 86 60" />
        <path d="M86 60 L70 50 M86 60 L74 74" />
      </>
    )}
    {kind === 'cross' && (
      <>
        <line class={dc} x1="20" y1="22" x2="80" y2="78" />
        <line class={dc} x1="80" y1="22" x2="20" y2="78" />
      </>
    )}
    {kind === 'burst' && (
      <>
        <line x1="50" y1="8" x2="50" y2="92" />
        <line x1="8" y1="50" x2="92" y2="50" />
        <line x1="20" y1="20" x2="80" y2="80" />
        <line x1="80" y1="20" x2="20" y2="80" />
      </>
    )}
    {kind === 'underline' && (
      <path class={dc} d="M6 46 C30 60 55 30 78 48 C86 54 92 50 96 46" />
    )}
    {kind === 'loop' && (
      <path class={dc} d="M10 60 C10 30 44 24 50 48 C55 68 30 74 30 54 C30 34 70 30 90 58" />
    )}
  </svg>
</div>
