---
import { works } from '../data/site';
import WorkCard from './WorkCard.astro';
const items = works.map((w, i) => ({ w, no: String(i + 1).padStart(2, '0'), i }));
const left = items.filter((_, i) => i % 2 === 0);
const right = items.filter((_, i) => i % 2 === 1);
---
<section class="panel p-work" id="work">
  <div class="panel__in">
    <div class="p-head"><h2 class="serif">Selected Work</h2></div>
    <div class="stagger-flat">
      {items.map((o) => <WorkCard w={o.w} no={o.no} i={o.i} order={o.i} />)}
    </div>
  </div>
</section>
