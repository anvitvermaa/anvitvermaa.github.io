---
// Generative plate for the EV Subsidy causal study — a Synthetic
// Difference-in-Differences motif: observed vs. synthetic counterfactual,
// with the treatment-effect gap shaded. Purely decorative line-art.
---
<div class="art art--sdid" data-art>
  <svg viewBox="12 16 592 366" role="img" aria-label="Synthetic difference-in-differences chart">
    <!-- axes -->
    <line class="ax" x1="60" y1="40" x2="60" y2="340" />
    <line class="ax" x1="60" y1="340" x2="600" y2="340" />
    <!-- gridlines -->
    <g class="grid">
      <line x1="60" y1="100" x2="600" y2="100" /><line x1="60" y1="160" x2="600" y2="160" />
      <line x1="60" y1="220" x2="600" y2="220" /><line x1="60" y1="280" x2="600" y2="280" />
    </g>
    <!-- intervention -->
    <line class="intv" x1="380" y1="40" x2="380" y2="340" />
    <text class="lbl" x="386" y="56">Policy 2025</text>

    <!-- effect gap -->
    <path class="gap" d="M380,180 L460,150 L540,125 L600,110 L600,152 L540,158 L460,168 Z" />

    <!-- synthetic control (counterfactual) -->
    <polyline class="line-ctrl draw" points="60,300 140,270 220,240 300,205 380,180 460,150 540,125 600,110" />
    <!-- observed treatment -->
    <polyline class="line-obs draw" points="60,300 140,270 220,240 300,205 380,180 460,168 540,158 600,152" />

    <circle class="dot" cx="600" cy="110" r="3.5" />
    <circle class="dot dot--obs" cx="600" cy="152" r="3.5" />

    <text class="lbl" x="470" y="128">Synthetic control</text>
    <text class="lbl lbl--obs" x="470" y="188">Observed</text>
    <text class="axl" x="330" y="372">t — 54 months</text>
    <text class="axl axl--y" x="-190" y="30">EV registrations</text>
  </svg>
</div>

<style>
  .art--sdid { display: block; height: 100%; }
  .art--sdid svg { width: 100%; height: 100%; display: block; }
  .art .ax { stroke: var(--ink-40); stroke-width: 1; }
  .art .grid line { stroke: var(--line); stroke-width: 1; }
  .art .intv { stroke: var(--ink-40); stroke-width: 1; stroke-dasharray: 3 4; }
  .art .gap { fill: var(--accent); opacity: 0.16; }
  .art .line-ctrl { fill: none; stroke: var(--ink); stroke-width: 1.6; }
  .art .line-obs { fill: none; stroke: var(--accent); stroke-width: 2; }
  .art .dot { fill: var(--ink); } .art .dot--obs { fill: var(--accent); }
  .art .lbl { font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; fill: var(--ink-60); text-transform: uppercase; }
  .art .lbl--obs { fill: var(--accent); }
  .art .axl { font-family: var(--mono); font-size: 10px; letter-spacing: 0.16em; fill: var(--ink-40); text-transform: uppercase; }
  .art .axl--y { transform: rotate(-90deg); transform-origin: 0 0; }

  .art .draw { stroke-dasharray: 900; stroke-dashoffset: 900; }
  html:not(.js) .art .draw { stroke-dashoffset: 0; }
</style>
