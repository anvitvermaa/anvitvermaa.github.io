---
import { profile } from '../data/site';
// About now lives on the first page — one tight paragraph so it all fits one screen.
const bio = [profile.bio[0]].filter(Boolean);
---
<section class="panel p-hero" id="hero">
  <div class="panel__in hero__in">
    <div class="hero__row">
      <div class="hero__center">
        <h1 class="hero-title serif">
          <span class="line-mask"><span class="line" data-line>Anvit Verma</span></span>
        </h1>
        <p class="hero__role serif" data-hero-fade><em>Data &amp; AI</em></p>
        <div class="hero__bio" data-hero-fade>
          {bio.map((p, i) => (
            <p class={i === 0 ? 'hero__p hero__p--lead' : 'hero__p'}>{p}</p>
          ))}
        </div>
      </div>

      <figure class="hero__photo" data-hero-fade>
        <img src={profile.photo} alt="Portrait of Anvit Verma" width="720" height="900" />
      </figure>
    </div>
  </div>
</section>

<style>
  .p-hero { min-height: 100vh; }
  .hero__in { position: relative; z-index: 1; min-height: min(90vh, 1000px);
    max-width: 1500px; display: flex; flex-direction: column; justify-content: center; }

  .hero__row { display: flex; align-items: center; justify-content: space-between;
    gap: clamp(2rem, 5vw, 5.5rem); width: 100%; }
  .hero__center { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; text-align: left; }
  .hero-title { letter-spacing: -0.03em; }
  .hero-title .line-mask { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .hero-title .line { display: block; font-weight: 500; color: var(--ink); line-height: 0.9;
    font-size: clamp(3.8rem, 11vw, 11rem); }
  .hero__role { color: var(--ink); line-height: 1; margin-top: clamp(0.4rem, 1.2vh, 1rem);
    font-size: clamp(2.3rem, 6vw, 5.6rem); }
  .hero__role em { font-style: italic; font-weight: 400; }

  .hero__bio { max-width: 50ch; margin-top: clamp(1.4rem, 3.5vh, 2.4rem); }
  .hero__p { color: var(--ink-80); font-size: clamp(1.1rem, 1.35vw, 1.35rem); line-height: 1.5; margin-bottom: 0; }
  .hero__p--lead { font-family: var(--serif); font-weight: 400; color: var(--ink);
    font-size: clamp(1.25rem, 1.75vw, 1.85rem); line-height: 1.4; letter-spacing: -0.01em; }

  .hero__photo { flex: 0 0 auto; width: clamp(200px, 23vw, 290px); aspect-ratio: 4 / 5;
    background: #ffffff; margin: 0; overflow: hidden; box-shadow: 0 20px 50px rgba(43, 0, 255, 0.28); }
  .hero__photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; display: block; }

  @media (max-width: 820px) {
    .hero__row { flex-direction: column-reverse; align-items: flex-start; gap: clamp(1.6rem, 6vw, 2.4rem); }
    .hero__photo { width: clamp(180px, 48vw, 240px); }
    .hero-title .line { font-size: clamp(2.8rem, 15vw, 5rem); }
  }
</style>
